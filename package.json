{
  "name": "alora-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@alora/client & npm run start:dev --workspace=@alora/server",
    "dev:client": "npm run dev --workspace=@alora/client",
    "dev:server": "npm run start:dev --workspace=@alora/server",
    "build": "npm run build --workspaces --if-present",
    "build:client": "npm run build --workspace=@alora/client",
    "build:server": "npm run build --workspace=@alora/server",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "deploy:prod": "npm run deploy:prod --workspace=@alora/server"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
