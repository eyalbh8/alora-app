{
  "name": "@alora/server",
  "version": "0.0.1",
  "description": "Alora NestJS API server",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build --workspace=@alora/shared && nest build",
    "start": "nest start",
    "start:dev": "npm run build --workspace=@alora/shared && cross-env NODE_ENV=dev dotenv -e .env -- nest start --watch",
    "start:debug": "cross-env NODE_ENV=dev dotenv -e .env -- nest start --debug --watch",
    "start:prod": "node dist/main-dev.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "echo \"no tests yet\"",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:deploy:prod": "cross-env NODE_ENV=prod dotenv -e .env.prod.local -- prisma migrate deploy",
    "fetch-secrets:prod": "ts-node --project tsconfig.fetch-secrets.json fetch-secrets.ts prod",
    "ecr:login": "bash ./make-ecr-login.sh",
    "deploy:prod": "npm run fetch-secrets:prod && npm run prisma:deploy:prod && npm run ecr:login && cross-env NODE_ENV=prod AWS_REGION=us-east-1 dotenv -e .env.prod -- serverless deploy --stage prod --force"
  },
  "dependencies": {
    "@alora/shared": "*",
    "@aws-sdk/client-secrets-manager": "^3.864.0",
    "@nestjs/common": "^11.0.14",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.14",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.1.1",
    "@prisma/client": "^6.6.0",
    "@vendia/serverless-express": "^4.12.6",
    "aws-lambda": "^1.0.7",
    "axios": "^1.8.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross-env": "^10.0.0",
    "dotenv-cli": "^10.0.0",
    "jose": "^6.0.10",
    "lodash": "^4.17.21",
    "nestjs-zod": "^4.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.4",
    "@nestjs/testing": "^11.0.14",
    "@types/aws-lambda": "^8.10.148",
    "@types/express": "^5.0.1",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.6.0",
    "serverless": "^4.12.0",
    "serverless-offline": "^14.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3"
  }
}
