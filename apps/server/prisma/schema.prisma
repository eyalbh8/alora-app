generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Descope-authenticated users (wl_users)
model WlUser {
  id        String         @id
  email     String         @unique
  name      String?
  isAdmin   Boolean        @default(false) @map("is_admin")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenants   WlUserTenant[]

  @@index([email])
  @@map("wl_users")
}

/// Tenant membership (wl_user_tenants)
model WlUserTenant {
  userId    String           @map("user_id")
  tenantId  String           @map("tenant_id") @db.Uuid
  role      String           @default("member")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    WhitelabelTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      WlUser           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, tenantId])
  @@index([tenantId], map: "wl_user_tenants_tenant_idx")
  @@map("wl_user_tenants")
}

/// Workspace row: SOURCE account mapping, MCP key, and brand display fields.
model WhitelabelTenant {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source_account_id      String            @unique @db.Uuid
  name                   String?
  domain                 String?
  domains                String[]          @default([])
  logo                   String?
  enabled                Boolean           @default(true)
  created_at             DateTime          @default(now()) @db.Timestamptz(6)
  mcp_api_key            String?
  dailyContentAutomation Boolean           @default(false) @map("daily_content_automation")
  dailyContentTimezone   String            @default("Asia/Nicosia") @map("daily_content_timezone")
  dailyContentHour       Int               @default(5) @map("daily_content_hour")
  /// Zernio multi-tenant profile id (one per Menchly workspace).
  zernioProfileId        String?           @map("zernio_profile_id")
  users                  WlUserTenant[]
  dailyContentRuns       DailyContentRun[]
  zernioAccounts         ZernioAccount[]
  publishedPosts         PublishedPost[]

  @@map("whitelabel_tenants")
}

/// Connected social account owned by a Menchly tenant via Zernio (one per platform in v1).
model ZernioAccount {
  id             String    @id
  tenantId       String    @map("tenant_id") @db.Uuid
  platform       String
  username       String?
  displayName    String?   @map("display_name")
  status         String    @default("connected")
  connectedAt    DateTime  @default(now()) @map("connected_at") @db.Timestamptz(6)
  disconnectedAt DateTime? @map("disconnected_at") @db.Timestamptz(6)

  tenant WhitelabelTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platform])
  @@index([tenantId])
  @@map("zernio_accounts")
}

/// Record of a post published via Zernio, with the live URL linked back to iGEO.
model PublishedPost {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  runId                    String?   @map("run_id") @db.Uuid
  igeoPostId               String    @map("igeo_post_id") @db.Uuid
  platform                 String
  zernioPostId             String?   @map("zernio_post_id")
  zernioAccountId          String?   @map("zernio_account_id")
  platformPostUrl          String?   @map("platform_post_url")
  publishedAt              DateTime  @default(now()) @map("published_at") @db.Timestamptz(6)
  igeoLinkedAt             DateTime? @map("igeo_linked_at") @db.Timestamptz(6)
  trackedRecommendationId  String?   @map("tracked_recommendation_id")
  linkError                String?   @map("link_error")

  tenant WhitelabelTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([igeoPostId, platform])
  @@index([tenantId])
  @@index([runId])
  @@map("published_posts")
}

/// One daily automation run per tenant per local calendar day.
model DailyContentRun {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  localDate             String    @map("local_date")
  status                String    @default("GENERATING")
  skipReason            String?   @map("skip_reason")
  promptId              String?   @map("prompt_id") @db.Uuid
  promptText            String?   @map("prompt_text")
  topicId               String?   @map("topic_id") @db.Uuid
  selectionRationale    String?   @map("selection_rationale")
  visibilityAtSelection Int?      @map("visibility_at_selection")
  lastContentAt         DateTime? @map("last_content_at") @db.Timestamptz(3)
  platforms             Json      @default("{}")
  error                 String?
  startedAt             DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(3)

  tenant WhitelabelTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, localDate])
  @@index([status])
  @@map("daily_content_runs")
}
