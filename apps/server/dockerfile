# Build context must be the monorepo root (see serverless.yml ecr.images.path).
FROM node:22-slim AS builder
WORKDIR /app

RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

ARG DATABASE_URL
ENV DATABASE_URL=$DATABASE_URL
RUN test -n "$DATABASE_URL" || (echo "DATABASE_URL build arg is EMPTY" && exit 1)

COPY package.json package-lock.json ./
COPY packages/shared ./packages/shared
COPY apps/server/package.json ./apps/server/
COPY apps/client/package.json ./apps/client/

# prepare scripts need shared sources present (@alora/shared runs tsc)
RUN npm ci

COPY apps/server ./apps/server

WORKDIR /app/apps/server
RUN npx prisma generate
RUN npx nest build

FROM public.ecr.aws/lambda/nodejs:22

WORKDIR ${LAMBDA_TASK_ROOT}

COPY --from=builder /app/apps/server/dist ./dist
COPY --from=builder /app/apps/server/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules

# Replace workspace symlink with real package files
RUN rm -rf ./node_modules/@alora/shared
COPY --from=builder /app/packages/shared/package.json ./node_modules/@alora/shared/package.json
COPY --from=builder /app/packages/shared/dist ./node_modules/@alora/shared/dist

ENV NODE_ENV=production

CMD ["dist/lambda.handler"]
