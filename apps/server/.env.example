# =============================================================================
# Menchly Server Environment Variables
# =============================================================================
# Copy to .env and fill in real values. Never commit .env.

# Local server
PORT=3003
NODE_ENV=dev

# Database (required for auth/tenant guards; health endpoints work without it)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Descope JWT verification
DESCOPE_PROJECT_ID=your-descope-project-id

# Upstream analytics API
SOURCE_API_BASE=https://api.example.com
SOURCE_API_KEY=

# MCP (optional; prefer per-tenant key stored on whitelabel_tenants)
MCP_URL=
MCP_API_KEY=

# CORS (production)
ALLOWED_ORIGIN=https://your-domain.com
