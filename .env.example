# AirOps Brand Kit Editor configuration.
# Copy this file to .env and fill in your real values.
#
# SECURITY WARNING: Vite inlines every VITE_-prefixed variable into the
# client bundle (import.meta.env), where anyone can read it in DevTools.
# The dev-server proxy in vite.config.ts reads the key from Node's
# process.env instead and never sends it to the browser — but that only
# protects you if you use the UN-prefixed name below. Prefer AIROPS_API_KEY.

# Recommended (server-side only, never bundled):
AIROPS_API_KEY=your_api_key_here
AIROPS_API_BASE=https://api.airops.com

# Legacy names (WARNING: VITE_ prefix = exposed in the client bundle):
VITE_AIROPS_API_KEY=your_api_key_here
VITE_AIROPS_API_BASE=https://api.airops.com

# The brand kit id is not a secret and is read by the client:
VITE_AIROPS_BRAND_KIT_ID=38990

# Webhook URL for an AirOps Playbook trigger that applies Brand Kit edits
# via MCP tools and leaves them in draft for human review + publish.
# There is NO public REST write endpoint for Brand Kits today.
VITE_SUBMIT_WEBHOOK_URL=https://your-airops-playbook-webhook-url

# When true, merge seed data for entities the public REST API does not
# return (regions, structured writing_rules, visual guidelines, etc.).
# Defaults to true so the UI matches AirOps Brand Kit during development.
VITE_SEED_MISSING_ENTITIES=true
