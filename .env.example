# Alora white-label snapshot UI (fixed tenant).
# Copy this file to .env and fill in your real values.
#
# SECURITY: DATABASE_URL and WHITELABEL_TENANT_ID are read only by the
# Vite/Lambda server — never prefix them with VITE_.

# Postgres connection for whitelabel_* snapshot tables (server-only):
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Fixed tenant UUID from whitelabel_tenants.id (server-only):
WHITELABEL_TENANT_ID=c03e3620-7abf-4412-9e50-93fc1098766d

# Optional — only for db/backfill.mjs and db/sync_traffic_snapshots.mjs:
# IGEO_API_KEY=your-igeo-api-bearer-token
