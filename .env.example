# =============================================================================
# Alora Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
#
# SECURITY: DATABASE_URL, DESCOPE_PROJECT_ID, and API keys are server-only.
# Only variables prefixed with VITE_ are bundled into the client.

# -----------------------------------------------------------------------------
# Database (Server-only)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Authentication (Descope)
# -----------------------------------------------------------------------------
# Server-side: Used for JWT verification
DESCOPE_PROJECT_ID=your-descope-project-id

# Client-side: Used by React app
VITE_DESCOPE_PROJECT_ID=your-descope-project-id

# Optional: Descope flow ID (defaults to "sign-up-or-in" so first login creates the user)
VITE_DESCOPE_FLOW_ID=sign-up-or-in

# -----------------------------------------------------------------------------
# Tenant (sync/backfill scripts only - NOT for authenticated browser requests)
# -----------------------------------------------------------------------------
# After adding auth, WHITELABEL_TENANT_ID is only used by sync/backfill scripts.
# Browser requests now send the selected tenant via X-Alora-Tenant-Id header.
WHITELABEL_TENANT_ID=c03e3620-7abf-4412-9e50-93fc1098766d

# -----------------------------------------------------------------------------
# iGEO Integration (optional - for carousel generation & backfill/sync)
# -----------------------------------------------------------------------------
# iGEO MCP for carousel posts and BrandHub (JSON-RPC)
IGEO_MCP_URL=https://api.igeo.ai/mcp
# Optional fallback only. Prefer pasting the per-account MCP URL in Alora (Carousel → Connect).
# IGEO_MCP_API_KEY=igeo_live_your_mcp_api_key_here

# Legacy REST API for sync scripts
# IGEO_API_KEY=your-igeo-api-bearer-token
# IGEO_ACCOUNT_ID=your-igeo-account-id

# -----------------------------------------------------------------------------
# AI Services (optional - for carousel generation only)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional. Defaults to claude-sonnet-5. Retired IDs like claude-sonnet-4-20250514 return 404.
# CLAUDE_MODEL=claude-sonnet-5
# OPENAI_API_KEY=your-openai-api-key
# FIGMA_ACCESS_TOKEN=your-figma-access-token

# -----------------------------------------------------------------------------
# Production (Amplify/Lambda only)
# -----------------------------------------------------------------------------
# ALLOWED_ORIGIN=https://your-domain.com
