# =============================================================================
# Alora Environment Variables
# =============================================================================
# Server: copy to apps/server/.env
# Client: copy VITE_* keys to apps/client/.env
#
# Only variables prefixed with VITE_ are bundled into the client.

# -----------------------------------------------------------------------------
# Database (Server-only)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Authentication (Descope)
# -----------------------------------------------------------------------------
DESCOPE_PROJECT_ID=your-descope-project-id
VITE_DESCOPE_PROJECT_ID=your-descope-project-id
VITE_DESCOPE_FLOW_ID=sign-up-or-in

# Production Amplify: set this to the Lambda Function URL + /api/snapshots
# (Amplify rewrites strip the Authorization header to external targets.)
# VITE_API_BASE=https://xxxx.lambda-url.us-east-1.on.aws/api/snapshots

# VITE_LOGO_DEV_API_KEY=pk_your_logo_dev_publishable_key

# -----------------------------------------------------------------------------
# Upstream analytics API (server-only)
# -----------------------------------------------------------------------------
# SOURCE_API_BASE=
# MCP_URL=
# MCP_API_KEY=
# SOURCE_API_KEY=

# -----------------------------------------------------------------------------
# Production deploy
# -----------------------------------------------------------------------------
# ALLOWED_ORIGIN=https://your-domain.com
# AWS_PROFILE=default
# AWS_REGION=us-east-1
# BUILD_DATABASE_URL=   # used as Docker build-arg for prisma generate
